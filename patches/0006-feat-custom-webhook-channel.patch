+	s := NewWebhookSender(zaptest.NewLogger(t))
+	cfg := datatypes.JSON(`{"url":"` + srv.URL + `","timeout_sec":99999}`)
+	if err := s.Send(context.Background(), cfg, "t", "c"); err != nil {
+		t.Fatalf("超时收敛后应发送成功: %v", err)
